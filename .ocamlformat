version = 0.29.0
profile = ocamlformat

# Put short body expressions on the same line as the pattern match
single-case = compact

# Keep 'and' keywords tight with 'let' bindings
let-and = compact

# Keep module items packed tightly together
let-module = compact

# FIXED: 'wrap' groups simple list/array items on the same line
break-collection-expressions = wrap

# FIXED: 'after' breaks after semicolons, keeping elements flowing smoothly
break-separators = after

# Max line width before forcing a wrap (higher means fewer line breaks)
margin = 100
